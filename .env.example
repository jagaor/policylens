# Configuración de PolicyLens
# Copia este fichero a .env y ajusta los valores según tu entorno.

# Clave de la API del LLM. Si se deja vacía, PolicyLens usará el mock LLM
# determinista (útil para tests y demos sin coste ni conexión externa).
OPENAI_API_KEY=

# URL base compatible con la API de OpenAI. Cámbiala si usas LiteLLM,
# un proxy corporativo u otro proveedor OpenAI-compatible.
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo del LLM a utilizar para generar las respuestas.
LLM_MODEL=gpt-4o-mini

# Tamaño de chunk en tokens para el splitter de ingesta.
CHUNK_SIZE=512

# Número de chunks a recuperar por consulta (Top-K).
TOP_K=3
